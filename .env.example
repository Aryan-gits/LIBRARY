# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign session tokens on the Express server.
# In production, set a long random string via environment secrets.
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"

# OPTIONAL SUPABASE CONFIGURATION
# Leave blank to run on the built-in Express + SQLite + WebSocket server.
# Provide your Supabase Project URL and Anon Key to enable Supabase integration.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
